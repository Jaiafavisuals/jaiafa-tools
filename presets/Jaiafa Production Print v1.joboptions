<<
  /CompatibilityLevel 1.4
  /AllowTransparency true
  /CompressPages true
  /CompressObjects /Tags
  /ColorConversionStrategy /LeaveColorUnchanged
  /EmbedAllFonts true
  /SubsetFonts true
  /MaxSubsetPct 100
  /CannotEmbedFontPolicy /Warning
  /PreserveOverprintSettings true
  /OPM 1
  /Optimize true
  /DoThumbnails false
  /DownsampleColorImages false
  /ColorImageResolution 300
  /EncodeColorImages true
  /ColorImageFilter /DCTEncode
  /AutoFilterColorImages true
  /ColorImageAutoFilterStrategy /JPEG
  /ColorACSImageDict << /QFactor 0.0 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
  /ColorImageDict << /QFactor 0.0 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
  /DownsampleGrayImages false
  /GrayImageResolution 300
  /EncodeGrayImages true
  /GrayImageFilter /DCTEncode
  /AutoFilterGrayImages true
  /GrayImageAutoFilterStrategy /JPEG
  /GrayACSImageDict << /QFactor 0.0 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
  /GrayImageDict << /QFactor 0.0 /HSamples [1 1 1 1] /VSamples [1 1 1 1] >>
  /DownsampleMonoImages false
  /MonoImageResolution 1200
  /EncodeMonoImages true
  /MonoImageFilter /CCITTFaxEncode
  /MonoImageDict << /K -1 >>
  /CheckCompliance [ /None ]
  /PDFX1aCheck false
  /PDFX3Check false
  /PDFXCompliantPDFOnly false
  /Namespace [ (Adobe) (Common) (1.0) ]
  /OtherNamespaces [
    <<
      /Namespace [ (Adobe) (CreativeSuite) (2.0) ]
      /AddBleedMarks false
      /AddColorBars false
      /AddCropMarks true
      /AddPageInfo false
      /AddRegMarks false
      /MarksOffset 6.0
      /MarksWeight 0.25
      /PageMarksFile /RomanDefault
      /ConvertColors /NoConversion
      /IncludeProfiles true
      /PreserveEditing false
      /UseDocumentBleed true
    >>
  ]
>> setdistillerparams
